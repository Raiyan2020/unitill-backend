# Local API
VITE_API_BASE_URL=http://127.0.0.1:8000/api
# Full backend origin (images, storage URLs) — production: https://unitill.uk
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000

# Production build (https://unitill.uk) — copy these into .env.production before npm run build on server:
# VITE_API_BASE_URL=https://unitill.uk/api
# VITE_BACKEND_ORIGIN=https://unitill.uk
